# Classes: inheritance, super(), class attributes, isinstance, type, and the
# full dunder set (arithmetic, comparison, __len__, __str__, __repr__).

class Shape:
    sides = 0

    def __init__(self, name):
        self.name = name

    def describe(self):
        return self.name + " has " + str(self.sides) + " sides"


class Square(Shape):
    sides = 4

    def __init__(self, size):
        super().__init__("square")
        self.size = size

    def area(self):
        return self.size * self.size

    def describe(self):
        return super().describe() + ", area " + str(self.area())


sq = Square(3)
print(sq.describe())
print(sq.name, sq.size, sq.sides)
print(Shape.sides, Square.sides)

print(isinstance(sq, Square))
print(isinstance(sq, Shape))
print(isinstance(Shape("x"), Square))
print(type(sq) == Square)
print(type(sq) == Shape)


class Money:
    def __init__(self, cents):
        self.cents = cents

    def __add__(self, other):
        return Money(self.cents + other.cents)

    def __sub__(self, other):
        return Money(self.cents - other.cents)

    def __mul__(self, n):
        return Money(self.cents * n)

    def __eq__(self, other):
        return self.cents == other.cents

    def __lt__(self, other):
        return self.cents < other.cents

    def __le__(self, other):
        return self.cents <= other.cents

    def __len__(self):
        return self.cents

    def __str__(self):
        return "$" + str(self.cents // 100) + "." + str(self.cents % 100)

    def __repr__(self):
        return "Money(" + str(self.cents) + ")"


a = Money(150)
b = Money(275)
print(str(a + b))
print(str(b - a))
print(str(a * 3))
print(a == Money(150))
print(a != b)
print(a < b)
print(b <= b)
print(len(a))
print(str(a))
print(repr(b))
print(f"{a} costs {a.cents} cents, or {a!r}")
print(a)
