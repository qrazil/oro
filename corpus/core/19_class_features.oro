# Classes: inheritance, super(), class attributes, type, and the full dunder
# set (arithmetic, comparison, __len__, __str__, __repr__).
#
# `type(x)` is the only type test Oro has, and it is exact: `type(sq)` is
# `Square` and not `Shape`, even though a Square is one. A *subclass* test has
# one place it matters and one spelling there — `except`, which matches an
# exception against a base by walking the chain. Everywhere else, the answer to
# "is this a Shape?" is to call the method Shape defines and let the override
# decide, which is what the `describe()` below does.

class Shape:
    sides = 0

    def __init__(self, name):
        self.name = name

    def describe(self):
        return self.name + " has " + f"{self.sides}" + " sides"


class Square(Shape):
    sides = 4

    def __init__(self, size):
        super().__init__("square")
        self.size = size

    def area(self):
        return self.size * self.size

    def describe(self):
        return super().describe() + ", area " + f"{self.area()}"


sq = Square(3)
print(sq.describe())
print(sq.name, sq.size, sq.sides)
print(Shape.sides, Square.sides)

print(type(sq) == Square)
print(type(sq) == Shape)
print(type(Shape("x")) == Square)


class Money:
    def __init__(self, cents):
        self.cents = cents

    def __add__(self, other):
        return Money(self.cents + other.cents)

    def __sub__(self, other):
        return Money(self.cents - other.cents)

    def __mul__(self, n):
        return Money(self.cents * n)

    def __eq__(self, other):
        return self.cents == other.cents

    def __lt__(self, other):
        return self.cents < other.cents

    def __le__(self, other):
        return self.cents <= other.cents

    def __len__(self):
        return self.cents

    def __str__(self):
        return "$" + f"{self.cents // 100}" + "." + f"{self.cents % 100}"

    def __repr__(self):
        return "Money(" + f"{self.cents}" + ")"


a = Money(150)
b = Money(275)
print(f"{a + b}")
print(f"{b - a}")
print(f"{a * 3}")
print(a == Money(150))
print(a != b)
print(a < b)
print(b <= b)
print(len(a))
print(f"{a}")
print(repr(b))
print(f"{a} costs {a.cents} cents, or {a!r}")
print(a)
