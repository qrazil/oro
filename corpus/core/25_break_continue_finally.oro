# break and continue must run any enclosing finally on the way out — cleanup
# that doesn't run is exactly the bug finally exists to prevent.

def break_runs_finally():
    log = []
    for _, i in range(5):
        try:
            if i == 2:
                break
            log.append(i)
        finally:
            log.append("f" + f"{i}")
    return log

print(break_runs_finally())

def continue_runs_finally():
    log = []
    for _, i in range(4):
        try:
            if i % 2 == 0:
                continue
            log.append(i)
        finally:
            log.append("c" + f"{i}")
    return log

print(continue_runs_finally())

# A nested try/finally: an inner break runs BOTH finally blocks.
def nested():
    log = []
    for _, i in range(3):
        try:
            try:
                if i == 1:
                    break
                log.append("body" + f"{i}")
            finally:
                log.append("inner" + f"{i}")
        finally:
            log.append("outer" + f"{i}")
    return log

print(nested())

# break inside a try that also has an except.
def with_except():
    log = []
    while true:
        try:
            log.append("body")
            break
        except ValueError:
            log.append("except")
        finally:
            log.append("finally")
    return log

print(with_except())

# continue in a while loop with finally.
#
# The counter is hand-rolled here on purpose, against the language's own rule
# that a bounded count is `for n in range(4)`. This is the case the rule exists
# to prevent: the increment is at the *top* of the body precisely because a
# `continue` below it would skip it and the loop would never end. That hazard
# is what is being tested, so the loop that has it has to stay.
def loop_continue():
    log = []
    n = 0
    for _, _ in range(4):
        n = n + 1
        try:
            if n == 2:
                continue
            log.append(n)
        finally:
            log.append("done" + f"{n}")
    return log

print(loop_continue())
