# str.split honours maxsplit. There is no `rsplit`: `split(sep, maxsplit,
# side=...)` is the one splitter, and a format spec is the one way to pad
# (there is no `zfill` either — see the last three lines).
#
# This file is the *left* arm of the split matrix — the half CPython can spell,
# so the oracle generates it. The right arm runs the same table with
# `side="right"` and lives in divergence/51_string_surface.oro, whose twin
# spells it `rsplit` and is where those answers come from.
print("a=b=c".split(sep="=", maxsplit=1))
print("a=b=c".split(sep="="))
print("a b c".split(sep=" ", maxsplit=2))
print("x:y".split(sep=":", maxsplit=0))
print(" a  b  c ".split(maxsplit=1))
print(" a  b  c ".split())
print("one".split(sep=",", maxsplit=5))

# The table. Same inputs as the right arm, so the two files read as one matrix.
SPLITS = [("a.b.c", "."), ("a..b", "."), (".a.", "."), ("", "."), ("aXXbXXc", "XX")]
print("--- split(sep=, maxsplit=)")
for s, sep in SPLITS:
    for m in [-1, 0, 1, 2, 5]:
        print(repr(s), repr(sep), m, s.split(sep=sep, maxsplit=m))

print("--- split(maxsplit=)")
for s in [" a  b  c ", "  a b  ", "   ", "", "a"]:
    for m in [-1, 0, 1, 2, 5]:
        print(repr(s), m, s.split(maxsplit=m))

print("--- bytes.split(sep=, maxsplit=)")
for m in [-1, 0, 1, 2, 5]:
    print(m, b"a.b.c".split(sep=b".", maxsplit=m), b"a..b".split(sep=b".", maxsplit=m))

print("--- bytes.split(maxsplit=)")
for m in [-1, 0, 1, 2, 5]:
    print(m, b" a  b  c ".split(maxsplit=m), b"  a b  ".split(maxsplit=m))

# What `zfill` used to spell. `{:05d}` pads a number, `{:0>5}` pads a string,
# and `{:0>{w}}` takes the width at run time — none of which `zfill` could do.
print(f"{7:03d}", f"{-7:04d}", f"{12345:03d}")
print(f"{'7':0>3}", f"{'-7':0>4}", f"{'':0>2}")
W = 6
print(f"{'42':0>{W}}", f"{42:0{W}d}")
