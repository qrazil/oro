# `type(x)` over the types CPython and Oro name identically — which is every
# type either can build except the five in divergence/54_type_names.oro. The
# oracle generates this file, so the agreement is checked rather than asserted.
#
# `type(x)` answers the type itself, and a type name is a keyword that denotes
# that same type — so `type(x) == str` is one comparison and the only type test
# the language has. For a user instance it answers the class, so
# `type(sq) == Square` works the same way (core/19_class_features.oro).

def f(x):
    return x


import re

print(type(1), type(0), type(-7), type(10 ** 30), type(2 ** 100))
print(type(1.5), type(.5), type(1e10), type(0.0))
print(type(true), type(false))
print(type("s"), type(""), type(b"b"), type(b""))
print(type([]), type([1, 2]), type(()), type((1,)), type({}), type({"a": 1}))
print(type(range(3)), type(range(0)))
print(type(f), type(re))

# The type name is the same string whatever the value inside is, which is the
# property that makes it usable as a dispatch key — std/json.oro does exactly
# this.
for v in [1, 1.5, "s", true, [1], {"a": 1}, (1,)]:
    print(type(v))

# Two values of one type answer the same thing, and two of different types do
# not — which is what makes it usable as a dispatch key at all.
print(type(1) == type(2), type(1) == type(1.5), type([]) == type(()))

# And the same answer compares equal to the type *name*, which is the point of
# the names being keywords: there is one way to ask what a value is.
print(type("s") == str, type(1) == int, type(1.5) == float, type(true) == bool)
print(type([]) == list, type(()) == tuple, type({}) == dict, type(b"") == bytes)
print(type(range(3)) == range, type(1) == str, type("s") == int)

# A type name is a value like any other: it can be held, passed and compared
# without a `type()` call around it.
print(str == str, str == int, [int, str][1] == str)
