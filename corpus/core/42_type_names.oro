# `type(x)` over the types CPython and Oro name identically — which is every
# type either can build except the six in divergence/54_type_names.oro. The
# oracle generates this file, so the agreement is checked rather than asserted.
#
# `type(x)` answers a *string* in Oro (`"<class 'int'>"`), not a type object;
# for a user instance it answers the class itself, so `type(sq) == Square` works
# (core/19_class_features.oro). Everything below prints the same bytes under
# both runtimes either way.

def f(x):
    return x


import re

print(type(1), type(0), type(-7), type(10 ** 30), type(2 ** 100))
print(type(1.5), type(.5), type(1e10), type(0.0))
print(type(true), type(false))
print(type("s"), type(""), type(b"b"), type(b""))
print(type([]), type([1, 2]), type(()), type((1,)), type({}), type({"a": 1}))
print(type(range(3)), type(range(0)))
print(type(f), type(re))

# The type name is the same string whatever the value inside is, which is the
# property that makes it usable as a dispatch key — std/json.oro does exactly
# this.
for v in [1, 1.5, "s", true, [1], {"a": 1}, (1,)]:
    print(type(v))

# Two values of one type answer the same thing, and two of different types do
# not — which is what makes it usable as a dispatch key at all. (That it is a
# *string* and therefore also sorts and keys a dict is Oro-only, and is in
# divergence/54_type_names.oro with the rest of the divergences.)
print(type(1) == type(2), type(1) == type(1.5), type([]) == type(()))
