# Oro has no truthiness: `if`, `while`, `and`, `or` and `not` take a `bool` and
# nothing else (see divergence/79_no_truthiness.oro for the faults a non-bool
# raises). These are the explicit tests that replace it, and every line here
# oracles against CPython, which agrees on each.
print(len("") == 0, len("x") == 0)
print(len([]) == 0, len([1]) == 0)
print(len({}) == 0, len({1: 2}) == 0)
print(0 == 0, 1 == 0, 0.0 != 0.0)
print(null == null)
x = null
if x == null:
    print("absent")
n = 3
if n != 0:
    print("nonzero")
print(true and true, true and false, false or true, false or false)
print(not true, not false)
