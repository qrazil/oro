class Point:
    def __init__(self, x, y):
        self.x = x
        self.y = y

    def __str__(self):
        return "Point(" + f"{self.x}" + ", " + f"{self.y}" + ")"

    def __eq__(self, other):
        return self.x == other.x and self.y == other.y

    def shift(self, dx, dy):
        return Point(self.x + dx, self.y + dy)

class Point3(Point):
    def __init__(self, x, y, z):
        self.x = x
        self.y = y
        self.z = z

    def __str__(self):
        return "Point3(" + f"{self.x}" + ", " + f"{self.y}" + ", " + f"{self.z}" + ")"

p = Point(1, 2)
print(f"{p}")
print(f"{p.shift(3, 4)}")
print(p == Point(1, 2))
print(p == Point(9, 9))
q = Point3(1, 2, 3)
print(f"{q}")
print(f"{q.shift(1, 1)}")
