lines = ["alice,30,dallas", "bob,25,austin", "carol,35,houston"]
rows = []
for line in lines:
    rows.append(line.split(","))

names = []
for r in rows:
    names.append(r[0].upper())
print(", ".join(names))

cities = []
for r in rows:
    cities.append(r[2])
print(sorted(cities))
print(rows[0], len(rows), rows[1][0].startswith("b"))
