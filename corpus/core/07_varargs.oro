def total(*nums):
    t = 0
    for n in nums:
        t = t + n
    return t

def describe(name, *tags, **opts):
    out = name
    for t in tags:
        out = out + " " + t
    keys = opts.keys()
    for k in keys:
        out = out + " " + k + "=" + f"{opts[k]}"
    return out

def forward(*args, **kwargs):
    return describe(*args, **kwargs)

print(total(1, 2, 3, 4))
print(total())
print(describe("box", "red", "small", w=3, h=4))
print(forward("box", "blue", h=9))
