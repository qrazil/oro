# A loop over a known count is `for … in range(…)`: the counter is the
# language's, so it cannot be forgotten, skipped by a `continue`, or stepped in
# the wrong place.
total = 0
for i in range(10):
    if i % 3 == 0:
        total = total + i
    elif i % 5 == 0:
        total = total + 100
    else:
        total = total - 1
print(total)

# `while` is for a condition that is not a count. This one stops when the value
# it is watching crosses a threshold, and nothing in it counts.
n = 1
steps = 0
while n < 1000:
    n = n * 3
    steps = steps + 1
print(n, steps)

n = 0
for x in range(5):
    n = n + x
print(n)

found = -1
for x in range(20):
    if x * x > 50:
        found = x
        break
print(found)

c = 0
for x in range(10):
    if x % 2 == 0:
        continue
    c = c + 1
print(c)
