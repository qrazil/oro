# DIVERGENCE: the collection protocol is an Oro-only spelling, so this cannot be
# oracled against CPython. Reviewed by hand. The *semantics* are not a
# divergence — every answer below is the one CPython gives for the equivalent
# Python — only the surface is.
#
# The companion is 69_comparison_dunders.oro, which holds everything that
# can be written as Python and is therefore generated by the oracle. This file
# is the rest of the surface: the chain methods that decide with `==` or `<`.
#
# `xs.any(y => y == a)` was the one collection operation that already got this
# right, because it calls back through `Op::Compare` — and that is precisely
# why `a in xs` disagreeing with it was the loudest form of the bug.


class Cell:
    def __init__(self, r):
        self.r = r

    def __eq__(self, other):
        return self.r == other.r

    def __repr__(self):
        return f"Cell({self.r})"


a = Cell(1)
b = Cell(1)
c = Cell(2)
cells = [b, c]

print("--- the two spellings of one question now agree")
print(a in cells, cells.any(y => y == a))
print(a in [c], [c].any(y => y == a))
print(cells.all(y => y == a), cells.count(y => y == a))
print(cells.find(y => y == a))
print(cells.partition(y => y == a))
print(cells.take_while(y => y == a), cells.drop_while(y => y == a))
print(cells.filter(y => y == a), cells.map(y => y == a))

print("--- a class with __eq__ is still not a dict key, and still not hashable")
# The deliberate decision in docs/hash-and-equality.md: an `HKey` is a pure Rust
# projection and a lookup has nowhere to call user code from, so a value type
# with custom equality keys by the value it compares by. `unique` is built on a
# dict, so it inherits that — and so does CPython's `dict.fromkeys` spelling of
# the same operation, which raises `unhashable type` too.
try:
    print(cells.unique())
except TypeError as e:
    print(e)
# `group_by` keys by whatever the callback returns, so it is fine as long as
# *that* is hashable — the restriction is on the key, not on the element.
print(cells.group_by(y => y.r))
d = {}
try:
    d[a] = 1
    print("UNREACHABLE")
except TypeError as e:
    print(e)
# The replacement, which is what the document recommends.
keyed = {}
keyed[(a.r,)] = "a"
print(keyed[(b.r,)])


class V:
    def __init__(self, n):
        self.n = n

    def __lt__(self, other):
        return self.n < other.n

    def __repr__(self):
        return f"V({self.n})"


vs = [V(3), V(1), V(2)]

print("--- the chain's orderings run __lt__ too")
print(vs.sort_by(v => v, reverse=true))
print(vs.min(), vs.max())
print(vs.sort_by(v => v))
print(vs.min_by(v => v), vs.max_by(v => v))
print((V(3), V(1), V(2)).sort_by(v => v))
print((V(3), V(1), V(2)).min())
print(vs.sort_by(v => v).map(v => v.n))

print("--- and they are shape-preserving, as the protocol promises")
print([V(2), V(1)].sort_by(v => v, reverse=true), (V(2), V(1)).sort_by(v => v, reverse=true))
print([V(2), V(1)].sort_by(v => v), (V(2), V(1)).sort_by(v => v))

print("--- an ordering with nothing to order by")
class Plain:
    def __repr__(self):
        return "Plain()"


try:
    print([Plain(), Plain()].sort_by(p => p))
except TypeError as e:
    print(e)
try:
    print([Plain(), Plain()].min_by(p => p))
except TypeError as e:
    print(e)

print("--- an exception from inside a dunder does not corrupt the job stack")
class Boom:
    def __eq__(self, other):
        raise ValueError("boom-eq")

    def __lt__(self, other):
        raise ValueError("boom-lt")

    def __repr__(self):
        return "Boom()"


try:
    print(1 in [Boom()])
except ValueError as e:
    print(e)
try:
    print([Boom(), Boom()].sort_by(b => b))
except ValueError as e:
    print(e)
try:
    print([Boom(), Boom()].min_by(x => x))
except ValueError as e:
    print(e)
# The chain still works afterwards, from inside a chain callback too.
print(cells.map(y => a in [y]))
print(vs.sort_by(v => v).map(v => [V(1), v].sort_by(w => w)))
