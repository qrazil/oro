# INTENTIONAL DIVERGENCE: every refusal below is a call CPython accepts.
# Reviewed by hand; every line is a claim in words. The calls CPython refuses
# too are in core/73_re_too_many_args.oro, where CPython checks them.
#
# The argument rule: a parameter with no default is passed by position, and
# one with a default is passed by name.
import re

def refused(label, thunk):
    try:
        thunk()
        print(label, "-> accepted")
    except TypeError as e:
        print(label, "->", e)

# --- a Match method's group index is required --------------------------------
# CPython lets `m.group()` mean `m.group(0)`. The number means itself, every
# call can say it, and `m.start(0)` is still valid CPython, so it is required.
m = re.search(r"(\w+)@(\w+)", "mail bob@host now")
print("group(0), start(0), end(0):", m.group(0), m.start(0), m.end(0))
print("group(1), start(1), end(1):", m.group(1), m.start(1), m.end(1))
refused("m.group()", () => m.group())
refused("m.start()", () => m.start())
refused("m.end()", () => m.end())
refused("m.group(n=1)", () => m.group(n=1))

# --- CPython's optional re arguments are refused, not ignored ----------------
# Oro implements none of `flags`, `count`, `maxsplit`, `pos` or `endpos`. They
# used to be accepted and dropped, which answered confidently and wrongly:
# `re.sub("a", "b", "aaa", 1)` is 'baa' in CPython and was 'bbb' here.
refused("re.sub(p, r, s, 1)", () => re.sub("a", "b", "aaa", 1))
print("without a count, sub replaces every match:", re.sub("a", "b", "aaa"))
refused("re.search(p, s, 0)", () => re.search("a", "xa", 0))
refused("re.fullmatch(p, s, 0)", () => re.fullmatch("a", "a", 0))
refused("re.findall(p, s, 0)", () => re.findall("a", "aaa", 0))
refused("re.finditer(p, s, 0)", () => re.finditer("a", "aaa", 0))
refused("re.split(p, s, 1)", () => re.split(",", "a,b,c", 1))
refused("re.compile(p, 0)", () => re.compile("a", 0))
print("a flag goes inline instead:", re.search("(?i)A", "xa").group(0))

p = re.compile(",")
refused("p.search(s, 1)", () => p.search("a,b", 1))
refused("p.fullmatch(s, 0)", () => p.fullmatch(",", 0))
refused("p.findall(s, 1)", () => p.findall("a,b,c", 1))
refused("p.finditer(s, 1)", () => p.finditer("a,b,c", 1))
refused("p.split(s, 1)", () => p.split("a,b,c", 1))
refused("p.sub(r, s, 1)", () => p.sub(";", "a,b,c", 1))
print("the forms Oro takes still answer:", p.split("a,b,c"), p.sub(";", "a,b,c"))

# Keywords were refused already, and still are.
refused("re.sub(p, r, s, count=1)", () => re.sub("a", "b", "aaa", count=1))
