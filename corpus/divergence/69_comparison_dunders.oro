# `__eq__` and `__lt__` are the class's answer everywhere equality and ordering
# are decided, not only at the `==` and `<` that name them.
#
# Before this, `__eq__` was dispatched by the comparison operator and by nothing
# else: `a == b` was true while `a in [b]` was false, and `sorted` of a class
# with `__lt__` raised a TypeError. The two spellings of one question — `a in xs`
# and `xs.any(y => y == a)` — gave different answers one line apart.
#
# All of this is CPython's behaviour — but the *spellings* that drive it are no
# longer all Python's. This was core/44_comparison_dunders until the `sorted`
# builtin was cut and `min`/`max` were narrowed to their variadic scalar form
# (a builtin takes scalars, a collection method takes a collection), and the
# ordering half of this file is written almost entirely in those three names.
# Splitting it was the alternative and it is worse: the classes below would have
# had to be defined twice, in two directories, free to drift apart — which is
# the failure this corpus exists to prevent.
#
# So the file moved whole and carries a twin (69_comparison_dunders.twin.py),
# which is this program in CPython's spellings. The .expected is that twin's
# output:
#
#   python3 corpus/divergence/69_comparison_dunders.twin.py \
#     | sed -E 's/\bTrue\b/true/g; s/\bFalse\b/false/g; s/\bNone\b/null/g' \
#     | diff - corpus/divergence/69_comparison_dunders.expected
#
# An empty diff is the review, so every answer below is still CPython's.
#
#   xs.sort(x => x) / xs.sort(f, reverse=)  ->  sorted(xs, ...)
#   xs = xs.sort(x => x)                     ->  xs.sort(...)
#   xs.min() / xs.max()                      ->  min(xs) / max(xs)
#
# `min(V(2), V(1), V(3))` is unchanged: two or more *values* is the form the
# builtin keeps, and it has no chain spelling.


class Cell:
    def __init__(self, r):
        self.r = r

    def __eq__(self, other):
        return self.r == other.r

    def __repr__(self):
        return f"Cell({self.r})"


a = Cell(1)
b = Cell(1)
c = Cell(2)

print("--- the operator, and everywhere else")
print(a == b, a == c)
print(a != b, a != c)
print(a in [b], a in [c], a not in [c])
print(a in (b,), a in (c,))
print([a] == [b], [a] == [c], [a] == [b, c])
print((a,) == (b,), (a, c) == (b, c))
print({"k": a} == {"k": b}, {"k": a} == {"k": c})

print("--- nested arbitrarily")
print([[a]] == [[b]])
print([(a, [b])] == [(b, [a])])
print({"x": [{"y": (a,)}]} == {"x": [{"y": (b,)}]})
print([[a]] in [[[b]]])
print([{"k": [a]}] == [{"k": [b]}])

print("--- the reflected operand")
# CPython asks the right operand when the left has nothing to say, so a class
# with `__eq__` decides against a plain int from either side.
class Half:
    def __init__(self, n):
        self.n = n

    def __eq__(self, other):
        return self.n == other

    def __repr__(self):
        return f"Half({self.n})"


h = Half(7)
print(h == 7, 7 == h)
print(h in [7], 7 in [h])
print([h] == [7], [7] == [h])
# `!=` reflects to `__ne__`, and only then to the negation of `__eq__`. Taking
# the shortcut straight to `__eq__` answers `{} != h` with what `h.__eq__` said
# instead of with its negation.
print(h != 7, 7 != h, {} != h, [] != h)
print(h != 8, 8 != h)

print("--- identity is a shortcut inside a container, and never at `==`")
# `a == a` runs __eq__ and believes it; `a in [a]` does not ask at all. Four
# lines that have to disagree, and a language that gets this wrong either
# hangs on a self-referential list or contradicts itself.
class Never:
    def __eq__(self, other):
        return false

    def __repr__(self):
        return "Never()"


n = Never()
print(n == n)
print(n in [n], [n] == [n], (n,) == (n,), {"k": n} == {"k": n})

# The shortcut has to be a loop and not a recursion: one list of many
# references to a single object settles every element without asking anything,
# and a Rust frame per element would be a stack overflow rather than an answer.
wide = []
for _, i in range(20000):
    wide.append(n)
other = wide[0:20000]
print(len(wide), wide == other, n in wide)

print("--- __eq__ may answer with anything, and `==` hands it back unconverted")
class Truthy:
    def __eq__(self, other):
        return [1, 2, 3]

    def __repr__(self):
        return "Truthy()"


class Falsy:
    def __eq__(self, other):
        return []

    def __repr__(self):
        return "Falsy()"


print(Truthy() == 1)
print(Truthy() in [1], 1 in [Truthy()], [Truthy()] == [1])
print(Falsy() == 1)
print(Falsy() in [1], [Falsy()] == [1])

print("--- __ne__ is its own dunder, and containers do not consult it")
class Ne:
    def __ne__(self, other):
        return "not equal"

    def __repr__(self):
        return "Ne()"


ne = Ne()
print(ne != 1)
print(ne == 1)
print([ne] != [1], [ne] == [1])

print("--- the operator the program wrote is the one the TypeError names")
for _, op in ["lt", "gt", "le", "ge"]:
    try:
        if op == "lt":
            print(1 < {})
        elif op == "gt":
            print(1 > {})
        elif op == "le":
            print([1] <= {})
        else:
            print(Half(1) >= 2)
    except TypeError as e:
        print(e)

print("--- ordering: __lt__ is what sorts")
class V:
    def __init__(self, n):
        self.n = n

    def __lt__(self, other):
        return self.n < other.n

    def __repr__(self):
        return f"V({self.n})"


vs = [V(3), V(1), V(4), V(1), V(5)]
print(V(1) < V(2), V(2) < V(1), V(2) > V(1))
print(vs.sort(v => v))
print(vs.sort(v => v, reverse=true))
print(vs.min(), vs.max())
print(min(V(2), V(1), V(3)), max(V(2), V(1), V(3)))
mutable = [V(3), V(1), V(2)]
mutable = mutable.sort(v => v)
print(mutable)
mutable = mutable.sort(v => v, reverse=true)
print(mutable)


def itself(v):
    return v


print(vs.sort(itself))
print(vs.sort(itself, reverse=true))
print([[V(2)], [V(1)]].min(), [[V(2)], [V(1)]].max())

print("--- a sort that needs __lt__ is still stable")
class Grade:
    def __init__(self, k, tag):
        self.k = k
        self.tag = tag

    def __lt__(self, other):
        return self.k < other.k

    def __repr__(self):
        return f"{self.k}{self.tag}"


ties = [Grade(1, "a"), Grade(0, "b"), Grade(1, "c"), Grade(0, "d"), Grade(1, "e")]
print(ties.sort(g => g))
print(ties.sort(g => g, reverse=true))

print("--- ordering nested in containers")
class W:
    def __init__(self, n):
        self.n = n

    def __eq__(self, other):
        return self.n == other.n

    def __lt__(self, other):
        return self.n < other.n

    def __repr__(self):
        return f"W({self.n})"


print([W(1)] < [W(2)], [W(2)] < [W(1)])
print([W(1), W(3)] < [W(1), W(4)])
print([W(1)] < [W(1), W(0)])
print((W(1), W(2)) < (W(1), W(3)))
print([[W(2)], [W(1)], [W(1), W(0)]].sort(w => w))

print("--- the reflected ordering dunder")
class OnlyGt:
    def __init__(self, n):
        self.n = n

    def __gt__(self, other):
        return self.n > other.n

    def __repr__(self):
        return f"OnlyGt({self.n})"


print([OnlyGt(2), OnlyGt(1)].sort(o => o))

print("--- a class with no ordering is still not orderable")
class Plain:
    def __repr__(self):
        return "Plain()"


for _, thunk in ["sort_by", "min", "max", "lt", "nested"]:
    try:
        if thunk == "sort_by":
            print([Plain(), Plain()].sort(p => p))
        elif thunk == "min":
            print([Plain(), Plain()].min())
        elif thunk == "max":
            print([Plain(), Plain()].max())
        elif thunk == "lt":
            print(Plain() < Plain())
        else:
            print([Plain()] < [Plain()])
    except TypeError as e:
        print(e)

print("--- an exception inside a dunder propagates")
class Boom:
    def __eq__(self, other):
        raise ValueError("boom-eq")

    def __lt__(self, other):
        raise ValueError("boom-lt")

    def __repr__(self):
        return "Boom()"


try:
    print(1 in [Boom(), 2])
except ValueError as e:
    print(e)
try:
    print([Boom()] == [1])
except ValueError as e:
    print(e)
try:
    print([Boom(), Boom()].sort(b => b))
except ValueError as e:
    print(e)
try:
    print([Boom(), Boom()].min())
except ValueError as e:
    print(e)

# The job stack must be intact afterwards: a comparison abandoned mid-flight
# used to be able to leave one behind.
print(a in [b], vs.sort(v => v))

print("--- a cycle is a RecursionError, not a hang and not a crash")
x = []
x.append(x)
y = []
y.append(y)
print(x == x)
try:
    print(x == y)
except RuntimeError as e:
    print(e)
try:
    print(x in [y])
except RuntimeError as e:
    print(e)
print(x == x, a in [b])
