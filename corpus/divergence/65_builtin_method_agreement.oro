# DIVERGENCE: nine builtins duplicate nine collection methods, and the method
# half (`.zip`, `.sorted`, `.enumerate`) is Oro's collection protocol, which
# CPython cannot run at all. `zip` and `enumerate` are eager here besides, so
# even the builtin half prints something CPython does not. Reviewed by hand.
#
# What this file pins is not either spelling's behaviour but the property that
# the two *agree*. Two of the nine pairs used to answer different things for the
# same word, which is the worst failure a duplicate surface can have:
#
#   [1, 2].zip([3, 4], [5, 6])   answered a two-way zip, discarding [5, 6]
#   sorted((3, 1, 2))            answered a list where (3, 1, 2).sorted() answered a tuple
#
# Every line below prints the builtin form and then the method form. They must
# match — every pair, on every argument, with no case left out.
#
# A dict used to be the case left out, because the two halves disagreed about
# what a dict's *element* is: a builtin walked one as its keys (the iteration
# protocol) and a collection method as its (key, value) pairs (the collection
# protocol), which separated `sorted`, `min`, `max`, `sum`, `enumerate` and
# `zip` on a dict argument and nothing else. That is now one answer and not two
# — iterating a dict yields the pair — so the dict block below is the record of
# the last of the nine disagreements closing.

# --- zip: the method takes N sequences, exactly as the builtin does ----------
print(zip([1, 2], [3, 4], [5, 6]))
print([1, 2].zip([3, 4], [5, 6]))
print(zip([1, 2], [3, 4]))
print([1, 2].zip([3, 4]))
print(zip([1, 2]))
print([1, 2].zip())
print(zip([1, 2, 3], [4, 5], [6, 7, 8, 9]))
print([1, 2, 3].zip([4, 5], [6, 7, 8, 9]))
print(zip([], [1], [2]))
print([].zip([1], [2]))
print(zip((1, 2), (3, 4), (5, 6)))
print((1, 2).zip((3, 4), (5, 6)))
print(zip(range(3), range(2), range(9)))
print(range(3).zip(range(2), range(9)))
for a, b, c in [1, 2].zip([3, 4], [5, 6]):
    print(a, b, c)

# --- sorted: both spellings preserve the shape they were handed -------------
print(sorted([3, 1, 2]))
print([3, 1, 2].sorted())
print(sorted((3, 1, 2)))
print((3, 1, 2).sorted())
print(sorted(()))
print(().sorted())
print(sorted(range(3, 0, -1)))
print(range(3, 0, -1).sorted())
print(type(sorted((3, 1, 2))), type((3, 1, 2).sorted()))

# The frame-driven spellings — `key=`, `reverse=`, and `sorted` handed over as a
# value — go through the VM rather than native code, and answer the same shape.
print(sorted((3, 1, 2), reverse=true))
print(sorted((3, 1, 2), key=x => -x))
print(sorted((3, 1, 2), key=x => -x, reverse=true))
print([(3, 1, 2), [3, 1, 2]].map(sorted))

# --- enumerate: the start is the only argument, and an extra one is refused --
print(enumerate([7, 8]))
print([7, 8].enumerate())
print(enumerate([7, 8], 1))
print([7, 8].enumerate(1))
try:
    print([7, 8].enumerate(1, 9))
except TypeError as e:
    print(e)
try:
    print(enumerate([7, 8], 1, 9))
except TypeError as e:
    print(e)

# --- a dict: one answer to "what is a dict's element?" ----------------------
# Both halves walk it as its (key, value) pairs, which is what `for k, v in d`
# yields. Nothing here was true before that change: every line was a pair of
# different answers.
d = {"b": 1, "a": 2}
print(min(d), d.min())
print(max(d), d.max())
print(enumerate(d), d.enumerate())
print(zip(d, [10, 20]), d.zip([10, 20]))
print(any(d), d.any())
print(all(d), d.all())
print(len(d), d.len())

# `sorted` follows the same rule it follows for a tuple: what it reordered is a
# sequence of entries, so a dict is what it rebuilds into.
print(sorted(d), d.sorted())
print(sorted({}), {}.sorted())
print(type(sorted(d)), type(d.sorted()))

# The one case that costs something: `sum` over a dict was a sum of keys and is
# now an attempt to add a tuple to an int. It is a TypeError on *both* sides —
# agreement is the property this file pins, and the two spellings agree about
# refusing it. `d.values().sum()` is how you add up a dict.
try:
    print(sum(d))
except TypeError as e:
    print("sum(d) ->", e)
try:
    print(d.sum())
except TypeError as e:
    print("d.sum() ->", e)
print(d.values().sum())
