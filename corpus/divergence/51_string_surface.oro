# The string surface Oro spells differently from CPython. Every answer here is
# still CPython's answer — the *names* diverge, not the semantics — so this file
# has a twin (51_string_surface.twin.py) written in CPython's spellings, and the
# .expected below is that twin's output:
#
#   python3 corpus/divergence/51_string_surface.twin.py \
#     | sed -E 's/\bTrue\b/true/g; s/\bFalse\b/false/g; s/\bNone\b/null/g' \
#     | diff - corpus/divergence/51_string_surface.expected
#
#   s.strip(side="left")     -> s.lstrip()
#   s.strip(side="right")    -> s.rstrip()
#   s.find(sub, reverse=true) -> s.rfind(sub)
#   s.split(sep, n, side="right") -> s.rsplit(sep, n)
#   s.rm_prefix(p)           -> s.removeprefix(p)
#   s.rm_suffix(p)           -> s.removesuffix(p)
#   s.is_digit() ...         -> s.isdigit() ...
#
# The four `is_*` predicates are supersets of CPython's on non-ASCII (combining
# marks and non-decimal numerals); 52_removed_string_methods.oro shows one, and
# every case here is one the two agree on.

STRS = ["  hi  ", "xxhixx", "xyxhixyx", "", "xxx", "\thi\n ", "ααhiα"]
CUTS = ["x", "xy", "", "α", "abc"]

print("--- strip(side=...)")
for _, s in STRS:
    print(repr(s), [s.strip(), s.strip(side="left"), s.strip(side="right"), s.strip(side="both")])

print("--- strip(chars, side=...)")
for _, s in STRS:
    for _, c in CUTS:
        print(repr(s), repr(c), s.strip(chars=c), s.strip(chars=c, side="left"), s.strip(chars=c, side="right"))

print("--- bytes.strip(side=...)")
for _, b in [b"  hi  ", b"aabaa", b"", b"\x00a\xff"]:
    print(b.strip(), b.strip(side="left"), b.strip(side="right"))
    print(b.strip(chars=b"a"), b.strip(chars=b"a", side="left"), b.strip(chars=b"a", side="right"))

# `find(sub, reverse=true)` replaces `rfind` — one name, one keyword, and the
# same positional window from either end.
print("--- find(sub, reverse=true)")
FIND = ["abcabc", "abc", "", "haééha"]
SUBS = ["b", "", "abc", "é", "zz"]
for _, s in FIND:
    for _, sub in SUBS:
        row = [s.find(sub), s.find(sub, reverse=true)]
        for _, start in [0, 1, -2]:
            row.append(s.find(sub, start=start, reverse=true))
        for _, end in [0, 3, 99]:
            row.append(s.find(sub, start=0, end=end, reverse=true))
        print(repr(s), repr(sub), row)

print("--- bytes find, reversed")
for _, b in [b"abcabc", b"abc", b"", b"\x00a\xff"]:
    for _, sub in [b"b", b"", b"abc", b"\xff"]:
        print(b.find(sub), b.find(sub, reverse=true), b.find(sub, start=1, reverse=true))

# The reason these two exist: `strip(chars)` is a character *set*, and reading
# it as a suffix is the classic Python footgun. Both spellings are printed side
# by side so the difference is impossible to miss.
print("--- rm_prefix / rm_suffix")
for _, s in ["ping.png", "banana.png", "png", "", "x.png.png"]:
    print(repr(s), repr(s.strip(chars=".png", side="right")), repr(s.rm_suffix(".png")))
    print(repr(s), repr(s.strip(chars="pin", side="left")), repr(s.rm_prefix("pin")))
print(repr("abc".rm_prefix("")), repr("abc".rm_suffix("")))
print(b"a.png".rm_suffix(b".png"), b"a.png".rm_suffix(b".gif"), b"a.png".rm_prefix(b"a."))

# `split(sep, maxsplit, side="right")` is what `rsplit(sep, maxsplit)` did. The
# *right* arm of the split matrix; the left arm is oracled directly in
# core/30_str_split_maxsplit.oro, over the same inputs.
print('--- split(sep=, maxsplit=, side="right")')
SPLITS = [("a.b.c", "."), ("a..b", "."), (".a.", "."), ("", "."), ("aXXbXXc", "XX")]
for _, (s, sep) in SPLITS:
    for _, m in [-1, 0, 1, 2, 5]:
        print(repr(s), repr(sep), m, s.split(sep=sep, maxsplit=m, side="right"))

print('--- split(maxsplit=, side="right")')
for _, s in [" a  b  c ", "  a b  ", "   ", "", "a"]:
    for _, m in [-1, 0, 1, 2, 5]:
        print(repr(s), m, s.split(maxsplit=m, side="right"))

print('--- bytes.split(sep=, maxsplit=, side="right")')
for _, m in [-1, 0, 1, 2, 5]:
    print(m, b"a.b.c".split(sep=b".", maxsplit=m, side="right"), b"a..b".split(sep=b".", maxsplit=m, side="right"))

print('--- bytes.split(maxsplit=, side="right")')
for _, m in [-1, 0, 1, 2, 5]:
    print(m, b" a  b  c ".split(maxsplit=m, side="right"), b"  a b  ".split(maxsplit=m, side="right"))

# The case the removal made worse, written both ways. `find(sep, reverse=true)`
# hands back an index and leaves the `+ 1` and the slice to the caller; `side=`
# hands back the fields.
print("--- split off the last field")
for _, path in ["a/b/c.txt", "c.txt", "/leading", "trailing/", ""]:
    i = path.find("/", reverse=true)
    print(repr(path), [path[:i], path[i + 1:]], path.split(sep="/", maxsplit=1, side="right"))

print("--- count(sub)")
for _, s in FIND:
    row = []
    for _, sub in SUBS:
        row.append(s.count(sub))
    print(repr(s), row)
for _, b in [b"abcabc", b"abc", b"", b"\x00a\xff"]:
    row = []
    for _, sub in [b"b", b"", b"abc", b"\xff"]:
        row.append(b.count(sub))
    print(row)

print("--- is_digit / is_alpha / is_alnum / is_space")
for _, s in ["123", "12a", "abc", "café", "a1", "", " ", " \t\n", "\x1c", "３", "ｄ"]:
    print(repr(s), s.is_digit(), s.is_alpha(), s.is_alnum(), s.is_space())
for _, b in [b"123", b"12a", b"abc", b"a1", b"", b" ", b" \t\x0b", b"\xff"]:
    print(b, b.is_digit(), b.is_alpha(), b.is_alnum(), b.is_space())

# `join` left the string surface entirely. The separator is the argument and
# the sequence the receiver — `", ".join(xs)` is `xs.join(", ")` — so this is
# the same operation with the same type rules and the same answers, reached
# from the other end. The message the old spelling answers with is in
# 52_removed_string_methods.oro; the arity probes below moved here out of
# core/39_method_arity.oro, where the call is now an AttributeError.
print("--- join")
print(repr(["a", "b", "c"].join("-")), repr(["a"].join("-")), repr([].join("-")))
print(repr(["a", "b"].join("")), repr(["alice", "bob"].join(", ")))
print(repr(("a", "b").join("-")))
print([b"a", b"b", b"c"].join(b","), [b"a", b"b"].join(b""), [].join(b","))

try:
    ["a"].join("-", 2)
    print('["a"].join("-", 2)', "-> no error")
except TypeError:
    print('["a"].join("-", 2)', "-> TypeError")

try:
    ["a"].join()
    print('["a"].join()', "-> no error")
except TypeError:
    print('["a"].join()', "-> TypeError")

# An element of the wrong type is a TypeError on both sides: CPython says
# `sequence item 1: expected str instance, int found`, Oro says
# `join() requires str elements, found 'int'`. Only the class is printed, so
# the twin still answers for it.
try:
    ["a", 1].join("-")
    print('["a", 1].join("-")', "-> no error")
except TypeError:
    print('["a", 1].join("-")', "-> TypeError")
