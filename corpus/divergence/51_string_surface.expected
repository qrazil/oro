'xyxhixyx' ['xyxhixyx', 'xyxhixyx', 'xyxhixyx', 'xyxhixyx']
'' ['', '', '', '']
'xxx' ['xxx', 'xxx', 'xxx', 'xxx']
'\thi\n ' ['hi', 'hi\n ', '\thi', 'hi']
'ααhiα' ['ααhiα', 'ααhiα', 'ααhiα', 'ααhiα']
--- strip(chars, side=...)
'  hi  ' 'x'   hi     hi     hi  
'  hi  ' 'xy'   hi     hi     hi  
'  hi  ' ''   hi     hi     hi  
'  hi  ' 'α'   hi     hi     hi  
'  hi  ' 'abc'   hi     hi     hi  
'  hi  ' None hi hi     hi
'xxhixx' 'x' hi hixx xxhi
'xxhixx' 'xy' hi hixx xxhi
'xxhixx' '' xxhixx xxhixx xxhixx
'xxhixx' 'α' xxhixx xxhixx xxhixx
'xxhixx' 'abc' xxhixx xxhixx xxhixx
'xxhixx' None xxhixx xxhixx xxhixx
'xyxhixyx' 'x' yxhixy yxhixyx xyxhixy
'xyxhixyx' 'xy' hi hixyx xyxhi
'xyxhixyx' '' xyxhixyx xyxhixyx xyxhixyx
'xyxhixyx' 'α' xyxhixyx xyxhixyx xyxhixyx
'xyxhixyx' 'abc' xyxhixyx xyxhixyx xyxhixyx
'xyxhixyx' None xyxhixyx xyxhixyx xyxhixyx
'' 'x'   
'' 'xy'   
'' ''   
'' 'α'   
'' 'abc'   
'' None   
'xxx' 'x'   
'xxx' 'xy'   
'xxx' '' xxx xxx xxx
'xxx' 'α' xxx xxx xxx
'xxx' 'abc' xxx xxx xxx
'xxx' None xxx xxx xxx
'\thi\n ' 'x' 	hi
  	hi
  	hi
 
'\thi\n ' 'xy' 	hi
  	hi
  	hi
 
'\thi\n ' '' 	hi
  	hi
  	hi
 
'\thi\n ' 'α' 	hi
  	hi
  	hi
 
'\thi\n ' 'abc' 	hi
  	hi
  	hi
 
'\thi\n ' None hi hi
  	hi
'ααhiα' 'x' ααhiα ααhiα ααhiα
'ααhiα' 'xy' ααhiα ααhiα ααhiα
'ααhiα' '' ααhiα ααhiα ααhiα
'ααhiα' 'α' hi hiα ααhi
'ααhiα' 'abc' ααhiα ααhiα ααhiα
'ααhiα' None ααhiα ααhiα ααhiα
