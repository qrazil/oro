-1 [b'a', b'b', b'c'] [b'a', b'b']
0 [b' a  b  c'] [b'  a b']
1 [b' a  b', b'c'] [b'  a', b'b']
2 [b' a', b'b', b'c'] [b'a', b'b']
5 [b'a', b'b', b'c'] [b'a', b'b']
