--- split(sep, maxsplit, side="right")
'a.b.c' '.' -1 ['a', 'b', 'c']
'a.b.c' '.' 0 ['a.b.c']
'a.b.c' '.' 1 ['a.b', 'c']
'a.b.c' '.' 2 ['a', 'b', 'c']
'a.b.c' '.' 5 ['a', 'b', 'c']
'a..b' '.' -1 ['a', '', 'b']
'a..b' '.' 0 ['a..b']
'a..b' '.' 1 ['a.', 'b']
'a..b' '.' 2 ['a', '', 'b']
'a..b' '.' 5 ['a', '', 'b']
'.a.' '.' -1 ['', 'a', '']
'.a.' '.' 0 ['.a.']
'.a.' '.' 1 ['.a', '']
'.a.' '.' 2 ['', 'a', '']
'.a.' '.' 5 ['', 'a', '']
'' '.' -1 ['']
'' '.' 0 ['']
'' '.' 1 ['']
'' '.' 2 ['']
'' '.' 5 ['']
'aXXbXXc' 'XX' -1 ['a', 'b', 'c']
'aXXbXXc' 'XX' 0 ['aXXbXXc']
'aXXbXXc' 'XX' 1 ['aXXb', 'c']
'aXXbXXc' 'XX' 2 ['a', 'b', 'c']
'aXXbXXc' 'XX' 5 ['a', 'b', 'c']
