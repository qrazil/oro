# INTENTIONAL DIVERGENCE.
# The four places `json` answers differently from CPython's, plus the two
# limits the native codec introduced. CPython cannot run this (`to_str()`,
# `to_int()`, `json.parse`), so the oracle cannot generate the baseline.
# Reviewed by hand.
#
# 36_json.oro pins the behaviour the Oro-written module had, and it passes
# unmodified against the Rust one. This file pins what is *new*: the nesting
# cap, the argument type, and the encoder's runaway-recursion guard.

import json

# --- 1. `parse` takes text, not octets ---------------------------------
# CPython's `json.loads` accepts str, bytes and bytearray, guessing an
# encoding for the last two. Oro decodes at the boundary and says so (§1):
# a program that has bytes writes `.to_str()`, which is also where an
# invalid encoding is reported, with the offset of the offending octet.

def try_parse(v):
    try:
        print(repr(json.parse(v)))
    except TypeError as e:
        print("TypeError:", e)
    except ValueError as e:
        print("ValueError:", e)

try_parse("[1, 2]")
try_parse(b"[1, 2]")
print(repr(json.parse(b"[1, 2]".to_str())))
try:
    json.parse(b"\xff[1]".to_str())
except ValueError as e:
    print("ValueError:", e)

# --- 2. duplicate keys ---------------------------------------------------
# Last value wins, at the first key's position. Same as CPython, and the
# same as `d[k] = v` twice.

print(json.parse("{\"a\": 1, \"b\": 2, \"a\": 3}"))

# --- 3. a lone surrogate is not a str Oro can hold -----------------------
# `\ud83d` with no low surrogate decodes, in CPython, to a `str` holding an
# unpaired surrogate — a value that cannot then be encoded as UTF-8. Oro's
# `str` is UTF-8, so there is no such value to produce and the escape is
# rejected. A *pair* joins, as it must.

print(json.parse("\"\\ud83d\\ude00\""))
try:
    json.parse("\"\\ud83d\"")
except ValueError as e:
    print("ValueError:", e)

# --- 4. nesting is capped ------------------------------------------------
# A document off a socket picks its own shape: one byte of `[` buys a heap
# container, so the depth is capped to bound the amplification. It is
# reported as an ordinary parse error at an ordinary position, so a handler
# that turns ValueError into 400 keeps doing that.

def depth(n):
    s = "[" * n + "]" * n
    try:
        v = json.parse(s)
        print(f"{n}: parsed")
    except ValueError as e:
        print(f"{n}: ValueError: {e}")

depth(1)
depth(200)
depth(10000)
depth(10002)
depth(300000)

# --- 5. and so is the encoder --------------------------------------------
# A value that contains itself, or one nested past the same cap, reports the
# runaway recursion the Oro-written encoder reported — a RuntimeError, not a
# ValueError, because it is the program's own structure and not input.

cycle = []
cycle.append(cycle)
try:
    json.stringify(cycle)
except RuntimeError as e:
    print("RuntimeError:", e)

nest = []
i = 0
while i < 12000:
    nest = [nest]
    i = i + 1
try:
    json.stringify(nest)
except RuntimeError as e:
    print("RuntimeError:", e)

# A structure just inside the cap still writes.
shallow = []
i = 0
while i < 500:
    shallow = [shallow]
    i = i + 1
print(len(json.stringify(shallow)))
