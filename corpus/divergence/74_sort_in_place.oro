# `xs.sort_in_place(f, reverse=false)`: sort a list where it is, by the keys
# `f` gives, and answer `null` as `append` and `extend` do.
#
# It is the in-place half of `sort_by`, and everything below is what CPython's
# `list.sort(key=…)` answers — the storage is reordered, every other name for
# the same list sees the new order, the sort is stable, and `reverse=true`
# leaves ties in the order they arrived. What has no CPython twin is what
# happens when a key function *writes* to the list it is sorting, and the
# refusals: those are in 75_collection_arity.oro.
#
# DIVERGENCE IN SPELLING, NOT IN BEHAVIOUR. CPython has no `sort_in_place`, so
# the file carries a twin (74_sort_in_place.twin.py) and the .expected below is
# that twin's output:
#
#   python3 corpus/divergence/74_sort_in_place.twin.py \
#     | sed -E 's/\bTrue\b/true/g; s/\bFalse\b/false/g; s/\bNone\b/null/g' \
#     | diff - corpus/divergence/74_sort_in_place.expected
#
# An empty diff is the review.
#
#   xs.sort(key=f, reverse=True)  ->  xs.sort_in_place(f, reverse=true)
#   xs.sort()                     ->  xs.sort_in_place(x => x)
def second(p):
    return p[1]


print("--- it answers null, and sorts where it is")
xs = [3, 1, 2]
print(xs.sort_in_place(x => x))
print(xs)

print("--- every name for the list sees it, because it is the same storage")
ys = [5, 4, 6]
alias = ys
nested = [ys]
ys.sort_in_place(x => x)
print(ys, alias, nested)
print(len(ys), ys[0], ys[-1])

print("--- empty, and one element")
empty = []
empty.sort_in_place(x => x)
print(empty)
one = [7]
one.sort_in_place(x => x)
print(one)

print("--- stable, and stable in reverse")
# Equal keys keep the order they arrived in, in *both* directions: `reverse=`
# inverts the comparator rather than the result, so it is not the same answer
# as sorting and then reversing.
ties = [("a", 2), ("b", 1), ("c", 2), ("d", 1)]
up = [("a", 2), ("b", 1), ("c", 2), ("d", 1)]
up.sort_in_place(second)
print(up)
down = [("a", 2), ("b", 1), ("c", 2), ("d", 1)]
down.sort_in_place(second, reverse=true)
print(down)
flipped = ties.sort_by(second).reversed()
print(flipped)

print("--- a key that is a native callable, and a destructuring key")
words = ["bbb", "a", "cc"]
words.sort_in_place(len)
print(words)
pairs = [("x", 3), ("y", 1), ("z", 2)]
pairs.sort_in_place((k, v) => v)
print(pairs)

print("--- keys that are containers, and a sort that keeps duplicates")
rows = [[2, "b"], [1, "a"], [2, "a"], [1, "b"]]
rows.sort_in_place(r => r)
print(rows)
dupes = [3, 1, 3, 1, 2]
dupes.sort_in_place(x => x, reverse=true)
print(dupes)

print("--- sorting a long list, where the reordering is the whole of the work")
long = []
for i in range(50):
    long.append(i * 37 % 50)
long.sort_in_place(x => x)
print(long.first(), long.last(), len(long))
print(long.take(5))
