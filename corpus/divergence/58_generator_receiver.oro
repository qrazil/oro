# The collection protocol, with a generator as the *receiver*.
#
# A native method runs in Rust and can never re-enter the interpreter, so it
# cannot resume a generator. The VM's answer is to drain one a frame at a time
# and retry the call, which it already did for a generator handed to a builtin
# and for the callback-driven half of the protocol (`g().map(f)`).
# The native half was never wired to it: `g().to_list()` surfaced an internal
# invariant message — `ForIter target is not an iterator` — and every no-callback
# method claimed a generator had no such method, though the README lists all
# sixteen of them as working on one.
#
# CPython cannot run this file: the methods are Oro's own spelling. Every answer
# below is the one CPython gives for the equivalent free function — `list(g)`,
# `sum(g)`, `sorted(g)`, `max(g)` — which is what this baseline was reviewed
# against. Those free functions are cut in Oro now (a builtin takes scalars, a
# collection method takes a collection), which leaves the methods below as the
# one spelling rather than one of two.
#
# A generator is consumed by this, exactly as it is under CPython, so each line
# below builds a fresh one.


def nums():
    for _, i in range(5):
        yield i


def pairs():
    yield "a", 1
    yield "b", 2


def words():
    yield "beta"
    yield "alpha"
    yield "beta"


# The two casts that read the receiver as a sequence.
print(nums().to_list())
print(pairs().to_dict())

# The no-callback protocol, all sixteen.
print(nums().sum(), nums().min(), nums().max(), nums().len())
print(nums().first(), nums().last())
print(nums().sort_by(x => x), nums().reversed(), nums().sort_by(x => x, reverse=true))
print(words().unique())
print(nums().take(2), nums().drop(3))
print(nums().chunk(2))
print(nums().zip([9, 8]))
print(words().join(", "))
print(nums().map(x => [x]).flatten())

# The callback half still works, and the two halves compose in one chain.
print(nums().filter(x => x % 2 == 0).sum())
print(nums().map(x => x * 2).sort_by(x => x).take(3))

# A generator is single-use: draining it once leaves it empty, as in CPython.
g = nums()
print(g.to_list(), g.to_list())

# An empty generator drains to an empty list, and `to_str`/`to_bool` still ask
# about the generator rather than about its elements — draining there would make
# an empty generator falsy and print a list where `<generator>` is the answer.


def empty():
    if false:
        yield 1


print(empty().to_list(), empty().sum(), empty().to_bool(), empty().to_str())

# A generator over generators drains through both, on the heap frame stack.


def outer():
    for _, x in nums():
        yield x * 10


print(outer().to_list(), outer().sum())
