--- it answers null, and sorts where it is
null
[1, 2, 3]
--- every name for the list sees it, because it is the same storage
[4, 5, 6] [4, 5, 6] [[4, 5, 6]]
3 4 6
--- empty, and one element
[]
[7]
--- stable, and stable in reverse
[('b', 1), ('d', 1), ('a', 2), ('c', 2)]
[('a', 2), ('c', 2), ('b', 1), ('d', 1)]
[('c', 2), ('a', 2), ('d', 1), ('b', 1)]
--- a key that is a native callable, and a destructuring key
['a', 'cc', 'bbb']
[('y', 1), ('z', 2), ('x', 3)]
--- keys that are containers, and a sort that keeps duplicates
[[1, 'a'], [1, 'b'], [2, 'a'], [2, 'b']]
[3, 3, 2, 1, 1]
--- sorting a long list, where the reordering is the whole of the work
0 49 50
[0, 1, 2, 3, 4]
