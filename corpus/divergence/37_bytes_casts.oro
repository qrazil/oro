# DIVERGENCE: everything about `bytes` that CPython can run lives in
# core/35_bytes.oro, where the oracle checks it. Only the two spellings CPython
# has no way to execute are here: the `to_str()`/`to_bytes()` casts (conversion
# is a method on the value, not a call on a type name), and `xs.join(b"")`,
# which Oro reverses so the sequence is the subject and the separator the
# detail. Reviewed by hand instead of oracled.

# str -> bytes is UTF-8 and cannot fail. There is no `encoding=` argument
# anywhere: UTF-8 is the one encoding.
s = "héllo"
b = s.to_bytes()
print(b, len(s), len(b))
print(b.to_str(), b.to_str() == s)
print("".to_bytes(), b"".to_str() == "")
# Each cast is a no-op on its own type.
print(b"ab".to_bytes(), "ab".to_str())

# bytes -> str is strict. Substituting replacement characters would corrupt a
# body rather than report it, so invalid UTF-8 raises. CPython's
# UnicodeDecodeError is a ValueError subclass, so this `except` is the same one.
try:
    print(b"\xff\xfe".to_str())
except ValueError as e:
    print("undecodable:", e)

# A UTF-8 sequence cut in half — the shape a fixed-size read actually produces.
truncated = "é".to_bytes()[:1]
print(truncated, len(truncated))
try:
    truncated.to_str()
except ValueError as e:
    print("half a character:", e)

# The collection protocol's join, reversed from CPython's: `xs.join(b"")`
# ends a chain instead of sending the reader back to the front of the line.
parts = [b"GET", b"/index.html", b"HTTP/1.1"]
print(parts.join(b" "))
print(parts.join(b""))
print([].join(b","), [b"solo"].join(b","))
# join never guesses a conversion, so a list mixing str and bytes is an error.
try:
    print([b"a", "b"].join(b""))
except Exception as e:
    print("mixed list rejected:", e)

# The chain that builds bytes without a bytearray: append to a list, join once.
out = []
out.append(b"HTTP/1.1 200 OK")
out.append(b"Content-Length: 2")
out.append(b"")
out.append(b"ok")
print(out.join(b"\r\n"))

# `bytes` is not callable; the error names both replacements.
try:
    bytes([1, 2])
except Exception as e:
    print("not callable:", e)

# A list of ints is the only way to *build* bytes from numbers. `bytes` is a
# sequence of ints, but until this cast nothing could go the other way: the
# int->char format spec produces a `str`, and a `str` becomes UTF-8, so 200 is
# two octets rather than one and `b"\xc8"` was unreachable from a computed
# value. That makes binary protocols unwriteable, which is why this is a
# building block and not a convenience.
print([97, 98, 99].to_bytes(), [].to_bytes(), (0, 200, 255).to_bytes())
print(len([200].to_bytes()), len(f"{200:c}".to_bytes()))
print([104, 105].to_bytes() == b"hi", [104, 105].to_bytes().to_str())
# A bool is an int here because a bool is an int everywhere else in Oro.
print([true, false, 98].to_bytes())
# An element that is not an octet is refused rather than truncated or wrapped:
# bytes built from a number that did not fit in a byte is silently wrong data.
try:
    print([1, 256].to_bytes())
except ValueError as e:
    print("out of range:", e)
try:
    print([-1].to_bytes())
except ValueError as e:
    print("negative:", e)
try:
    print([104, "i"].to_bytes())
except ValueError as e:
    print("not an int:", e)
