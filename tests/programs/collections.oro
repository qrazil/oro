# Building lists and dicts, indexing, iteration, tuple unpacking.
squares = []
for i in range(6, start=1):
    squares.append(i * i)
print(squares)

counts = {}
for w in ["red", "blue", "red", "green", "blue", "red"]:
    counts[w] = counts.get(w, default=0) + 1
print(counts)

for word, n in counts:
    print(word, n)

pairs = [(1, "one"), (2, "two"), (3, "three")]
for num, word in pairs:
    print(num, word)

d = {"a": 1, "b": 2}
print(d.keys())
print(d.values())
print("a" in d, "z" in d)

grid = {}
grid[(0, 0)] = "origin"
grid[(1, 2)] = "point"
print(grid[(0, 0)], grid[(1, 2)])
print((1, 2) in grid)
