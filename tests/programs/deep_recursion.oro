# Deep recursion — 20000 frames — proving the heap-allocated call-frame design
# (architecture point 1): the interpreter never recurses in Rust, so this does
# not overflow the native stack.
def count_down(n):
    if n == 0:
        return 0
    return 1 + count_down(n - 1)

print(count_down(20000))

# Factorial that overflows i64 and promotes to a bignum (architecture point 4).
def factorial(n):
    result = 1
    for _, i in range(n + 1, start=1):
        result = result * i
    return result

print(factorial(30))
