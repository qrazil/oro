# *args / **kwargs collection and forwarding.
def describe(label, *args, **kwargs):
    print(label)
    print(args)
    total = 0
    for a in args:
        total = total + a
    print(total)
    print(kwargs.get("scale", default=1))

def forward(*args, **kwargs):
    return describe(*args, **kwargs)

describe("direct", 1, 2, 3, scale=10)
forward("forwarded", 4, 5, 6, scale=20)

def add(a, b, c=100):
    return a + b + c

print(add(1, 2))
print(add(1, 2, 3))
print(add(1, 2, c=50))

args = [7, 8]
opts = {"c": 9}
print(add(*args, **opts))
