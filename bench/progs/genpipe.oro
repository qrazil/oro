# Generator pipeline: three chained generators, each resuming a suspended frame
# per element. Exercises frame push/pop and the yield/resume path.
#
# The counter here is hand-rolled on purpose: a benchmark's loop is inside its
# measurement. See bench/RESULTS.md, "Why the benchmarks still count by hand".
def counter(n):
    i = 0
    while i < n:
        yield i
        i = i + 1


def evens(src):
    for _, x in src:
        if x % 2 == 0:
            yield x


def scaled(src, k):
    for _, x in src:
        yield x * k


total = 0
for _, v in scaled(evens(counter(300000)), 3):
    total = total + v

print(total)
