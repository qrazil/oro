# String building: 200k f-string formats appended to a list, then joined.
#
# The counter here is hand-rolled on purpose: a benchmark's loop is inside its
# measurement. See bench/RESULTS.md, "Why the benchmarks still count by hand".
parts = []
i = 0
while i < 200000:
    parts.append(f"{i}")
    i = i + 1

s = parts.join(",")
print(len(s))
