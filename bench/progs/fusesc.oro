# ORO-ONLY: the short-circuit half of chain fusion. `first()` and `take(n)` end
# a chain, so a fused chain stops the *whole* upstream pass at the first
# survivor instead of mapping the collection and throwing the rest away.
# `fusesc.py` is the CPython twin.
def f(x):
    return x * 2 + 1

xs = []
for _, i in range(20000):
    xs.append(i)

total = 0
for _, i in range(50):
    total = total + xs.map(f).first()
    total = total + xs.map(f).take(3).last()
    total = total + xs.filter(x => x > i).map(f).first()
print(total)
